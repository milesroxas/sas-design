use "resources/fonts/Geist-Variable.ttf"
use "resources/fonts/GeistMono-Variable.ttf"

import "tokens/colors.elyx" as colorTokens
import "tokens/type.elyx" as typeTokens
import "tokens/type-size.elyx" as sizeTokens
import "tokens/space.elyx" as spaceTokens
import "tokens/layout.elyx" as layoutTokens

// A token specimen: every color token as a swatch and the seven text roles.
// Render with --context theme=dark or --context media=mobile to check contexts.
// One color swatch: a chip and its token name.
export swatch = frame {
  left: 0px,
  top: -400px,
  width: 152px,
  layout: {stack: {direction: .column, item-gap: spaceTokens.space.s-2}},
  children: [chip, swatchName],

  chip = frame {
    width: 100%,
    height: 64px,
    fill: colorTokens.colors.background,
    border: colorTokens.colors.border,
    corner-radius: spaceTokens.radius.md
  }

  swatchName = text {
    width: 100%,
    fill: colorTokens.colors.muted-foreground,
    contents: "token",
    font-size: sizeTokens.typeSize.eyebrow,
    font-family: typeTokens.fonts.mono,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.sm
  }
}

// A group heading inside the specimen.
export specimenHeading = text {
  left: 240px,
  top: -400px,
  fill: colorTokens.colors.foreground,
  contents: "Group",
  font-size: sizeTokens.typeSize.subheading,
  font-family: typeTokens.fonts.sans,
  font-style: typeTokens.fontStyles.normal,
  line-height: typeTokens.leading.subheading,
  letter-spacing: typeTokens.tracking.subheading
}

