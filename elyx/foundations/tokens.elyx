export typeSpecimen = frame {
  title: "Type roles",
  caption: "The seven text roles from sas-site typography.ts. media=mobile shows the 375px end of each clamp.",
  left: 1824px,
  top: 0px,
  width: layoutTokens.layout.viewport,
  layout: {stack: {direction: .column, item-gap: spaceTokens.space.s-12}},
  fill: colorTokens.colors.background,
  padding: [spaceTokens.space.s-24, layoutTokens.layout.gutter],
  children: [
    displaySample,
    headingSample,
    subheadingSample,
    leadSample,
    bodySample,
    smSample,
    eyebrowSample,
    codeSample
  ],

  displaySample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Display: hero and statement",
    font-size: sizeTokens.typeSize.display,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.display,
    letter-spacing: typeTokens.tracking.display
  }

  headingSample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Heading: page title, section opener",
    font-size: sizeTokens.typeSize.heading,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.heading,
    letter-spacing: typeTokens.tracking.heading
  }

  subheadingSample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Subheading: a block's own heading",
    font-size: sizeTokens.typeSize.subheading,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.subheading,
    letter-spacing: typeTokens.tracking.subheading
  }

  leadSample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Lead: deck, statement, item title",
    font-size: sizeTokens.typeSize.lead,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.lead,
    letter-spacing: typeTokens.tracking.lead
  }

  bodySample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Body: all running copy. Suits & Sandals builds brands, websites and products for companies with complex stories.",
    font-size: sizeTokens.typeSize.body,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.body,
    letter-spacing: typeTokens.tracking.body
  }

  smSample = text {
    width: 100%,
    fill: colorTokens.colors.foreground,
    contents: "Small: captions, meta, list items",
    font-size: sizeTokens.typeSize.sm,
    font-family: typeTokens.fonts.sans,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.sm,
    letter-spacing: typeTokens.tracking.sm
  }

  eyebrowSample = text {
    fill: colorTokens.colors.foreground,
    contents: "Eyebrow: kicker above a heading",
    font-size: sizeTokens.typeSize.eyebrow,
    font-family: typeTokens.fonts.mono,
    font-style: typeTokens.fontStyles.medium,
    line-height: typeTokens.leading.eyebrow
  }

  codeSample = text {
    fill: colorTokens.colors.foreground,
    contents: "const code = 'Geist Mono 13 on 24'",
    font-size: sizeTokens.typeSize.code,
    font-family: typeTokens.fonts.mono,
    font-style: typeTokens.fontStyles.normal,
    line-height: typeTokens.leading.code
  }
}
